enum Role {
  SUPER_ADMIN       
  MARKETER         
  ONLINE_SALESMAN   
  OFFLINE_SALESMAN  
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum SalaryStatus {
  PENDING
  PAID
}



enum StockMovementType {
  PURCHASE_IN    // new stock added by admin
  SALE_OUT       // stock reduced by a sale
  RETURN_IN      // stock returned by customer
  ADJUSTMENT     // manual correction (damage, loss, recount)
}



enum ProductStatus {
  ACTIVE
  DISCONTINUED   // soft-deleted / archived, hidden from catalog pickers, history stays intact
}

enum SaleChannel {
  ONLINE
  OFFLINE
}

enum SaleStatus {
  DRAFT                // online cart saved before checkout, not yet a real order
  PENDING              // created, not yet confirmed/paid
  CONFIRMED            // confirmed, stock deducted
  COMPLETED            // fulfilled/delivered
  CANCELLED            // cancelled before fulfillment, stock restored
  PARTIALLY_RETURNED   // some line items returned, rest stands
  RETURNED             // fully returned, stock restored via RETURN_IN
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  ROCKET
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}
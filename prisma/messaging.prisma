model MessagingConnection {
  id                 String                    @id @default(cuid())
  platform           MessagingPlatform
  providerAccountId  String
  accountName        String?
  status             MessagingConnectionStatus @default(ACTIVE)
  accessTokenCiphertext  String                @db.Text
  refreshTokenCiphertext String?               @db.Text
  tokenExpiresAt     DateTime?
  grantedScopes      String[]                  @default([])

  conversations MessagingConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, providerAccountId])
  @@index([platform, status])
}

model MessagingConversation {
  id                    String             @id @default(cuid())
  connectionId          String
  connection            MessagingConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  providerConversationId String
  participantId         String?
  participantName       String?
  lastMessageAt         DateTime?

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, providerConversationId])
  @@index([connectionId, lastMessageAt])
}

model Message {
  id                    String                 @id @default(cuid())
  conversationId        String
  conversation           MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerMessageId     String
  direction             MessagingDirection
  deliveryStatus        MessagingDeliveryStatus @default(RECEIVED)
  text                  String?                @db.Text
  media                 Json?
  sentAt                DateTime
  expiresAt             DateTime // Set on ingestion; a cleanup job must delete expired messages.

  createdAt DateTime @default(now())

  @@unique([conversationId, providerMessageId])
  @@index([conversationId, sentAt])
  @@index([expiresAt])
}

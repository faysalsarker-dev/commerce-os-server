enum ExpenseFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model ExpenseCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  expenses Expense[]
  schedule  ExpenseSchedule?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model ExpenseSchedule {
  id String @id @default(cuid())

  categoryId String           @unique
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Recurrence configuration
  frequency ExpenseFrequency
  interval  Int              @default(1)

  // Due-date configuration
  dueDateEnabled Boolean @default(false)

  // Weekly: 1 = Monday, 7 = Sunday
  daysOfWeek Int[] @default([])

  // Monthly: [5] or [1, 15]
  // Yearly: day(s) of the selected month
  daysOfMonth Int[] @default([])

  // Required for yearly due dates (1-12)
  monthOfYear Int?

  // Expected amount, not an actual expense
  expectedAmount Decimal? @db.Decimal(12, 2)

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  // Reminder configuration
  reminderEnabled    Boolean @default(false)
  reminderDaysBefore Int     @default(3)

  isActive Boolean @default(true)

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startDate])
}

model Expense {
  id String @id @default(cuid())

  categoryId String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Optional: connects an actual payment to its recurring schedule
  scheduleId String?
  schedule    ExpenseSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())

  description String?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseDate])
  @@index([categoryId, expenseDate])
  @@index([scheduleId])
}

# Keep real credentials in deployment secrets, never commit them.
# Configure only the messaging platforms you enable. Meta credentials cover its products.
# MESSAGING_TOKEN_ENCRYPTION_KEY should be a random, base64-encoded 32-byte key.
MESSAGING_TOKEN_ENCRYPTION_KEY=
MESSAGING_RETENTION_DAYS=7
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# 32-byte AES-256-GCM key encoded as 64 hexadecimal characters.
COURIER_ENC_KEY=70daf2e292bfc0928db44a942e5954082388f8a95602f3643b34bb3bf34e0e62
PUBLIC_API_URL=http://localhost:3000/api/v1
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_SANDBOX_BASE_URL=https://hermes-sandbox.pathao.com
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
